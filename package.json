{
  "name": "destroyer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 5173",
    "build": "vp build --configLoader native && vp build --ssr server.ts --outDir dist/server --configLoader native",
    "preview": "node dist/server/server.js",
    "fmt": "vp fmt .",
    "lint": "vp lint src server.ts tests vite.config.ts vitest.production.config.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vp test run",
    "test:unit": "vp test run",
    "test:production": "vp test run --config vitest.production.config.ts",
    "test:browser": "playwright test",
    "test:journey": "playwright test tests/browser/operations-workspace.spec.ts --grep responsiveness",
    "test:heap": "playwright test tests/browser/operations-workspace.spec.ts --grep 'heap plateau'",
    "acceptance": "npm run check && npm run test:production && npm run test:browser",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.0.89 <0.1.0",
    "@askrjs/auth": ">=0.0.9 <0.1.0",
    "@askrjs/charts": ">=0.1.6 <0.2.0",
    "@askrjs/lucide": ">=0.0.9 <0.1.0",
    "@askrjs/node": ">=0.0.9 <0.1.0",
    "@askrjs/schema": ">=0.0.6 <0.1.0",
    "@askrjs/server": ">=0.0.13 <0.1.0",
    "@askrjs/themes": ">=0.0.24 <0.1.0",
    "@askrjs/ui": ">=0.0.27 <0.1.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@askrjs/vite": ">=0.0.13 <0.1.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
